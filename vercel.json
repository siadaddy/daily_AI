{
  "crons": [
    {
      "path": "/api/reports/generate?period=weekly",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/reports/generate?period=monthly",
      "schedule": "30 1 1 * *"
    },
    {
      "path": "/api/auto-reports/generate?period=weekly",
      "schedule": "10 1 * * 1"
    },
    {
      "path": "/api/auto-reports/generate?period=monthly",
      "schedule": "40 1 1 * *"
    }
  ]
}
